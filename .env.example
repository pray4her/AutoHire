DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autohire"

APP_BASE_URL="http://localhost:3000"
APP_NAME="AutoHire"
APP_RUNTIME_MODE="auto"

# Account track (Better Auth): open email+password registration with email
# verification codes. SECRET must be at least 32 characters
# (generate: openssl rand -base64 32). URL defaults to APP_BASE_URL when unset.
BETTER_AUTH_SECRET="<replace-with-a-random-secret-min-32-chars>"
BETTER_AUTH_URL="http://localhost:3000"
INVITE_TOKEN_SECRET="<replace-with-a-random-secret>"
SESSION_COOKIE_NAME="autohire_session"
SESSION_COOKIE_MAX_AGE_SECONDS="604800"

FILE_STORAGE_MODE="mock"
ALIYUN_OSS_REGION="<replace-me>"
ALIYUN_OSS_BUCKET="<replace-me>"
ALIYUN_OSS_ENDPOINT="<replace-me>"
ALIYUN_OSS_TRANSFER_ACCELERATION_ENABLED="false"
ALIYUN_OSS_ACCELERATE_ENDPOINT="https://oss-accelerate.aliyuncs.com"
ALIYUN_OSS_ACCESS_KEY_ID="<replace-me>"
ALIYUN_OSS_ACCESS_KEY_SECRET="<replace-me>"

RESUME_ANALYSIS_MODE="mock"
RESUME_ANALYSIS_BASE_URL="<replace-me>"
RESUME_ANALYSIS_API_KEY="<replace-me>"
RESUME_ANALYSIS_REANALYZE_PATH="/internal/resume-analysis/jobs/{jobId}/reanalyze"
RESUME_ANALYSIS_MAPPINGS_PATH="/internal/resume-analysis/mappings"
RESUME_ANALYSIS_CALLBACK_SECRET="<replace-with-a-random-secret>"
RESUME_ANALYSIS_CALLBACK_URL="https://autohire.example.com/api/internal/resume-analysis/secondary/callback"
# Upload confirm auto-starts direct secondary (41-field) analysis upstream.
# unset: enabled only when RESUME_ANALYSIS_MODE=live; mock defaults to off.
# RESUME_ANALYSIS_AUTO_SECONDARY_ON_UPLOAD="false"

MATERIAL_REVIEW_MODE="mock"
MATERIAL_REVIEW_BASE_URL="<replace-me>"
# Shared Bearer token for AutoHire -> GO_EIIE /reviews/* calls and
# GO_EIIE -> AutoHire /api/internal/material-review/* read-only context calls.
MATERIAL_REVIEW_API_KEY="<replace-me>"
MATERIAL_REVIEW_INTEGRATION_IDENTITY_PATH="/reviews/applications/{applicationId}/integration-identity"
MATERIAL_REVIEW_MAPPING_PATH="/reviews/applications/{applicationId}/mapping"
MATERIAL_REVIEW_CALLBACK_SECRET="<replace-with-a-random-secret>"

ASK_AI_MODE="mock"
ASK_AI_ALIYUN_BASE_URL="https://dashscope.aliyuncs.com"
ASK_AI_ALIYUN_API_KEY="<replace-me>"
ASK_AI_ALIYUN_APP_ID="<replace-me>"
ASK_AI_DEFAULT_LOCALE="zh-CN"
ASK_AI_TRACE_RAW_RESPONSE="false"
ASK_AI_MAX_QUESTION_CHARS="1000"
ASK_AI_TIMEOUT_MS="60000"

AUDIT_DASHBOARD_TOKENS=""
AUDIT_DASHBOARD_COOKIE_NAME="autohire_audit_session"
AUDIT_DASHBOARD_COOKIE_MAX_AGE_SECONDS="28800"

# Ops expert-files / invitations shared login (single username; independent from AUDIT_DASHBOARD_TOKENS).
# INITIAL_PASSWORD seeds the account on first login when none exists.
OPS_EXPERT_FILES_USERNAME="ops"
OPS_EXPERT_FILES_INITIAL_PASSWORD=""
OPS_EXPERT_FILES_COOKIE_NAME="autohire_ops_expert_files_session"
OPS_EXPERT_FILES_COOKIE_MAX_AGE_SECONDS="28800"

# Ops referrals login (separate from expert-files / invitations).
# OPS_REFERRAL_USERNAME: comma-separated Referral Ops Account allowlist (e.g. "ops,alice,bob").
# INITIAL_PASSWORD seeds each allowlisted account on first login when that account does not exist yet.
OPS_REFERRAL_USERNAME="ops"
OPS_REFERRAL_INITIAL_PASSWORD=""
OPS_REFERRAL_COOKIE_NAME="autohire_ops_referral_session"
OPS_REFERRAL_COOKIE_MAX_AGE_SECONDS="28800"

# Ops expert-files ZIP export (Function Compute). Required when using export APIs with FILE_STORAGE_MODE=oss.
OPS_EXPORT_FC_ENDPOINT=""
OPS_EXPORT_FC_SERVICE_NAME=""
OPS_EXPORT_FC_FUNCTION_NAME=""
OPS_EXPORT_FC_ACCESS_KEY_ID=""
OPS_EXPORT_FC_ACCESS_KEY_SECRET=""
OPS_EXPORT_FC_REGION=""
OPS_EXPORT_CALLBACK_SECRET="<replace-with-a-random-secret>"
# Optional; defaults to INVITE_TOKEN_SECRET for estimateToken HMAC.
OPS_EXPORT_ESTIMATE_SECRET=""

# Leave both empty to disable Sentry (no client reports, no /monitoring tunnel).
# Client reads NEXT_PUBLIC_SENTRY_DSN; server accepts either variable.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

SMTP_HOST="<replace-me>"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<replace-me>"
SMTP_PASS="<replace-me>"
EMAIL_FROM="noreply@example.com"
# smtp (default) uses Nodemailer; recording captures mail in-process for e2e OTP hooks.
EMAIL_TRANSPORT_MODE="smtp"
